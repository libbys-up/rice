*~
.cpm
.curry
.DS_Store
.vscode

# generated by cypm from package.json's configModule
src/Rice/PackageConfig.curry

# runtime/'s Makefile build output
runtime/*.o
runtime/*.o.flags
runtime/*.a
runtime/runtime_smoke
runtime/runtime_smoke.dSYM/

# scratch build artifacts (test/test.c's own compiled binary)
test/a.out

# tests/run.sh's per-test scratch dirs (.curry cache + compiled binaries);
# tests/programs/ stays source-only
tests/.run/

# tests/bench.sh's per-config scratch dirs and results.tsv
tests/.bench/

# tests/bootstrap.sh's copies of the tree and logs
tests/.bootstrap/

# tests/optbench.sh's results and builds
tests/.optbench*/

# LaTeX build byproducts (src/*.tex compiled locally; the .pdf itself is
# committed as the actual deliverable, these auxiliary files aren't)
src/*.aux
src/*.log
src/*.out

# rice's objects, one directory per compiler and flags (Rice.Main.objDirName)
obj-*/

# make frontend's output
/bin/
