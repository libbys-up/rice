{
  "name": "rice",
  "version": "2.0.3",
  "author": "Steven Libby <libbys@up.edu>",
  "synopsis": "An optimizing compiler for Curry.",
  "category": [ "Compilers" ],
  "license": "BSD-3-Clause",
  "licenseFile": "LICENSE",
  "dependencies": {
    "base"               : ">= 3.4.0, < 4.0.0",
    "containers"         : ">= 3.0.0, < 4.0.0",
    "currypath"          : ">= 3.0.0, < 4.0.0",
    "directory"          : ">= 3.0.0, < 4.0.0",
    "filepath"           : ">= 3.0.0, < 4.0.0",
    "flatcurry"          : ">= 3.0.0, < 6.0.0",
    "flatcurry-transform": ">= 0.0.2, < 0.1.0",
    "flatcurry-typed"    : ">= 3.0.0, < 6.0.0",
    "frontend-exec"      : ">= 3.0.0, < 4.0.0",
    "icurry"             : ">= 3.3.0, < 4.0.0",
    "process"            : ">= 3.0.0, < 4.0.0",
    "profiling"          : ">= 3.0.0, < 4.0.0",
    "read-legacy"        : ">= 3.0.0, < 4.0.0",
    "rw-data"            : ">= 1.1.0, < 2.0.0",
    "scc"                : ">= 3.0.0, < 4.0.0",
    "time"               : ">= 3.0.0, < 4.0.0"
